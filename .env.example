# ─────────────────────────────────────────────────────────────
#  WEKNDGAMES! — Environment Variables
#  Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Google Maps Platform API Key
# ────────────────────────────
# Get yours at: https://console.cloud.google.com/apis/credentials
#
# Required APIs to enable in your Google Cloud project:
#   • Places API (New)
#   • Maps JavaScript API (for future map tiles)
#
# SECURITY: Restrict this key to your domain in GCP Console:
#   API restrictions → HTTP referrers → yourdomain.com/*
#
# NOTE: This key is embedded in the browser bundle (Vite VITE_ prefix).
# Domain restriction is the standard security model for browser Maps keys.
#
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Custom Search API (used by scripts/fetch-google-search-images.mjs)
# ─────────────────────────────────────────────────────────────────────────────
# Create a Custom Search Engine at https://programmablesearchengine.google.com/
# and enable the Custom Search JSON API in Google Cloud Console.
#
GOOGLE_CSE_API_KEY=AIzaSyBcNKB7cfW-j_o5-BJgNV2jiaXDCgEL8hs
GOOGLE_CSE_ID=your_google_cse_engine_id_here
